SECRET_KEY=replace-with-a-long-random-value
APP_HOST=0.0.0.0
APP_PORT=5000
DATABASE_PATH=amp.db
# Supabase Postgres connection string. When set, this takes precedence over DATABASE_PATH.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SESSION_COOKIE_SECURE=0
ACTIVITY_VIEWER_EMAILS=security@your-company.com
PASSWORD_RESET_ADMIN_EMAILS=security@your-company.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=APM Change Control <no-reply@your-verified-domain.com>
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USER=notifications@your-company.com
OUTLOOK_SMTP_PASSWORD=your-app-password
